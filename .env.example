# Next.js Environment Variables Config

# Node Environment ("development", "production", "test")
NODE_ENV="production"

# App Deployment URLs
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Database Configuration (PostgreSQL connection URI)
# In production, use connection pooling and enforce TLS/SSL (e.g. sslmode=require)
DATABASE_URL="postgresql://db_user:db_password@db_host:5432/medivault_db?schema=public"

# Auth.js Credentials (generate a cryptographically secure 32-byte key)
# Command: openssl rand -hex 32
AUTH_SECRET="place_a_cryptographically_secure_random_key_here"

# NextAuth trusted host configuration
# AUTH_TRUST_HOST must be "true" when deploying to Vercel/cloud providers.
AUTH_TRUST_HOST="true"
AUTH_URL="https://your-domain.com/api/auth"

# OAuth Credentials (optional — for future social sign-in support)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI & OCR Service Credentials (optional — for future cloud OCR providers)
OPENAI_API_KEY=""
OCR_SPACE_API_KEY=""
OPENFDA_API_KEY=""
