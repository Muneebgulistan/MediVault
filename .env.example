# Environment Variables — Copy to .env and fill in real values

# Node Environment
NODE_ENV="development"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/medivault_db?schema=public"

# Auth.js Secret — Generate with: openssl rand -hex 32
AUTH_SECRET="your-super-secret-key-at-least-32-characters-long"

# NextAuth trusted host (required in production)
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000/api/auth"

# OAuth Credentials (optional — for future Google sign-in support)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI & OCR Service Credentials (prepared for future setup)
OPENAI_API_KEY=""
OCR_SPACE_API_KEY=""
