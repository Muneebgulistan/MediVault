datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum PrescriptionStatus {
  DRAFT
  PROCESSING
  EXTRACTED
  REVIEW_REQUIRED
  VERIFIED
  ARCHIVED
}

enum VerificationStatus {
  AI_EXTRACTED
  USER_EDITED
  USER_VERIFIED
  PHYSICIAN_VERIFIED
}

enum AdministrationRoute {
  ORAL
  TOPICAL
  INHALATION
  INJECTION
  OPHTHALMIC
  OTIC
  NASAL
  OTHER
}

model User {
  id                String               @id @default(cuid())
  name              String?
  email             String               @unique
  emailVerified     DateTime?
  image             String?
  // Hashed password for credentials authentication. Null for OAuth users.
  password          String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  prescriptions     Prescription[]
  medicineSchedules MedicineSchedule[]
  accounts          Account[]
  sessions          Session[]

  @@index([email])
}

// NextAuth.js Adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Prescription {
  id               String                 @id @default(cuid())
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  doctorName       String?
  prescriptionDate DateTime?
  notes            String?
  status           PrescriptionStatus     @default(DRAFT)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  files            PrescriptionFile[]
  medicines        PrescriptionMedicine[]

  @@index([userId])
  @@index([status])
  @@index([prescriptionDate])
}

model PrescriptionFile {
  id               String       @id @default(cuid())
  prescriptionId   String
  prescription     Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  originalFilename String
  storagePath      String
  mimeType         String
  fileSize         Int
  uploadedAt       DateTime     @default(now())

  @@index([prescriptionId])
}

model Medicine {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  genericName           String?
  brandNames            String[]               @default([])
  category              String?
  description           String?
  sideEffects           String?
  interactions          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  prescriptionMedicines PrescriptionMedicine[]
  medicineSchedules     MedicineSchedule[]

  @@index([name])
  @@index([genericName])
}

model PrescriptionMedicine {
  id                 String              @id @default(cuid())
  prescriptionId     String
  prescription       Prescription        @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId         String
  medicine           Medicine            @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  dosage             String
  frequency          String
  route              AdministrationRoute @default(ORAL)
  duration           String?
  instructions       String?
  quantity           Int?
  confidence         Float?
  verificationStatus VerificationStatus  @default(AI_EXTRACTED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  schedules          MedicineSchedule[]

  @@index([prescriptionId])
  @@index([medicineId])
  @@index([verificationStatus])
}

model MedicineSchedule {
  id                     String                @id @default(cuid())
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicineId             String
  medicine               Medicine              @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  prescriptionMedicineId String?
  prescriptionMedicine   PrescriptionMedicine? @relation(fields: [prescriptionMedicineId], references: [id], onDelete: SetNull)
  scheduledTime          String
  startDate              DateTime
  endDate                DateTime?
  dosage                 String
  instructions           String?
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([userId])
  @@index([medicineId])
  @@index([isActive])
  @@index([startDate, endDate])
}
